# ==========================================
# PREVENTIVATORE ENVIRONMENT VARIABLES (.env)
# ==========================================

# Database URL per il container Web (connette al servizio Postgres container 'db')
DATABASE_URL=postgresql://preventivatore_user:secretpassword@db:5432/preventivatore_db

# Credenziali PostgreSQL per il container 'db'
POSTGRES_USER=preventivatore_user
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=preventivatore_db

# Chiave segreta JWT per firmare i token di autenticazione
# (In produzione sostituisci con una chiave sicura: openssl rand -hex 32)
JWT_SECRET=croceecuore-arte-sacra-secret-key-2026-preventivatore

# Password iniziale per l'utente amministratore ('admin') al primo avvio
ADMIN_INITIAL_PASSWORD=admin123

# Porta del server FastAPI (Default: 8000)
PORT=8000
