# ==========================================
# PREVENTIVATORE ENVIRONMENT VARIABLES (.env)
# ==========================================

# PostgreSQL URL per lo sviluppo locale (connettendosi al container Docker db su localhost:5432)
# Nota: se l'app gira DENTRO il container Docker, l'host e' 'db' invece di 'localhost' (gestito da docker-compose)
DATABASE_URL=postgresql://preventivatore_user:secretpassword@localhost:5432/preventivatore_db

# Credenziali Postgres (usate da docker-compose.yml)
POSTGRES_USER=preventivatore_user
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=preventivatore_db

# Chiave segreta JWT per la firma dei token di autenticazione
# (In produzione genera una stringa casuale e sicura: openssl rand -hex 32)
JWT_SECRET=croceecuore-arte-sacra-secret-key-2026-preventivatore

# Password iniziale per l'utente amministratore ('admin') al primo avvio
ADMIN_INITIAL_PASSWORD=admin123

# Porta del server FastAPI (Default: 8000)
PORT=8000
